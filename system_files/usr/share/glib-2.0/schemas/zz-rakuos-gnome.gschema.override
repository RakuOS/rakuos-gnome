[org.gnome.desktop.interface]
color-scheme='prefer-dark'
gtk-theme='OrigamiPaper'
icon-theme='Colloid-Dark'
cursor-theme='Bibata-Modern-Classic'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='Maple Mono NF 11'

[org.gnome.desktop.wm.preferences]
button-layout='appmenu:minimize,maximize,close'

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/rakuos/default.jpg'
picture-uri-dark='file:///usr/share/backgrounds/rakuos/default.jpg'
picture-options='zoom'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/rakuos/default.jpg'
picture-options='zoom'

[org.gnome.shell]
enabled-extensions=['appindicatorsupport@rgcjonas.gmail.com', 'no-overview@fthx', 'dash-to-dock@micxgx.gmail.com', 'blur-my-shell@aunetx']
